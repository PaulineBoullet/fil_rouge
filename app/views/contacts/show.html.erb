<h1 class="visually-hidden"><%= @contact.full_name %></h1>

<%= render "shared/date_toolbar" %>

<%= render "shared/summary_panel",
           title: "#{@contact.full_name} · synthèse du contact",
           summary: @summary %>

<h2 class="section-title">Mails du <%= @date.strftime("%d/%m/%Y") %></h2>

<% if @emails.any? %>
  <div class="email-list">
    <%= render partial: "emails/email", collection: @emails %>
  </div>
<% else %>
  <div class="empty-state">
    <p>Aucun mail avec ce contact à cette date.</p>
  </div>
<% end %>
