<%= simple_form_for contact do |f| %>
  <div class="modal-body">
    <%= f.error_notification message: "Merci de corriger les champs signalés." %>
    <%= f.input :display_name, label: "Nom" %>
    <%= f.input :email, label: "Adresse mail", placeholder: "prenom.nom@exemple.fr" %>
    <%= f.association :company, label: "Domaine tiers", collection: Company.order(:name), include_blank: "D'après l'adresse",
                      hint: "Laissé vide, le domaine tiers est celui de l'adresse s'il existe." %>
  </div>
  <div class="modal-footer">
    <%= link_to "Annuler", contacts_path, class: "btn btn-outline-secondary", data: { bs_dismiss: "modal" } %>
    <%= f.button :submit, contact.new_record? ? "Ajouter le correspondant" : "Enregistrer", class: "btn-primary" %>
  </div>
<% end %>
