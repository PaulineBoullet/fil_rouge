<% content_for :title, "Collaborateurs – Fil rouge" %>
<%= render "shared/page_head", title: "Collaborateurs",
           subtitle: "Adresses du domaine #{Setting.org_domain.presence || "de l'organisation"}. Les mails d'un collaborateur non validé ne s'affichent pas.",
           actions: link_to("Ajouter un collaborateur", new_employee_path, class: "btn btn-outline-secondary", data: { turbo_frame: "modal" }) %>

<%= render "shared/section_head", title: "À valider", count: @pending.size %>
<% if @pending.any? %>
  <% @pending.each do |employee| %>
    <%= form_with url: validate_employee_path(employee), method: :patch, id: dom_id(employee, :validate), class: "d-none" do %><% end %>
  <% end %>
  <div class="list-table">
    <table class="table align-middle mb-0">
      <caption class="visually-hidden">Collaborateurs à valider</caption>
      <thead><tr><th scope="col">Adresse détectée</th><th scope="col">Nom proposé (modifiable)</th><th scope="col">Apparu le</th><th scope="col">Mails</th><th scope="col"></th></tr></thead>
      <tbody>
        <% @pending.each do |employee| %>
          <tr>
            <td><%= employee.email %></td>
            <td><%= text_field_tag :display_name, employee.name, form: dom_id(employee, :validate), class: "form-control", aria: { label: "Nom de #{employee.email}" } %></td>
            <td><%= @first_seen[employee.id] ? l(@first_seen[employee.id].to_date, format: "%-d %B") : "—" %></td>
            <td><%= @email_counts.fetch(employee.id, 0) %></td>
            <td class="text-end"><%= button_tag "Valider", form: dom_id(employee, :validate), class: "btn btn-primary btn-sm" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="muted-small">Aucun collaborateur à valider.</p>
<% end %>

<%= render "shared/section_head", title: "Validés", count: @validated.size %>
<div class="list-table">
  <table class="table align-middle mb-0">
    <caption class="visually-hidden">Collaborateurs validés</caption>
    <thead><tr><th scope="col">Collaborateur</th><th scope="col">Fils</th><th scope="col">Dernier échange</th><th scope="col"></th></tr></thead>
    <tbody>
      <% @validated.each do |employee| %>
        <tr>
          <td>
            <span class="person-cell"><%= initials_avatar(employee, size: 32) %>
              <span><strong><%= employee.name %></strong><br><span class="muted-small"><%= employee.email %></span></span>
            </span>
          </td>
          <td><%= @conversation_counts.fetch(employee.id, 0) %></td>
          <td><%= @last_exchange[employee.id] ? day_label(@last_exchange[employee.id].to_date) : "—" %></td>
          <td class="text-end">
            <%= render "shared/row_actions", edit_path: edit_employee_path(employee), delete_path: employee_path(employee),
                       confirm: "Supprimer #{employee.name} ? Ses mails restent en base, sans collaborateur associé." %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
