<%= simple_form_for employee do |f| %>
  <div class="modal-body">
    <%= f.error_notification message: "Merci de corriger le champ signalé." %>
    <%= f.input :display_name, label: "Nom affiché", hint: "Adresse : #{employee.email}" %>
  </div>
  <div class="modal-footer">
    <%= link_to "Annuler", companies_path, class: "btn btn-outline-secondary", data: { bs_dismiss: "modal" } %>
    <%= f.button :submit, "Enregistrer", class: "btn-primary" %>
  </div>
<% end %>
