<%= simple_form_for employee do |f| %>
  <div class="modal-body">
    <%= f.error_notification message: "Merci de corriger les champs signalés." %>
    <%= f.input :display_name, label: "Nom" %>
    <%= f.input :email, label: "Adresse mail", placeholder: "prenom.nom@#{Setting.org_domain.presence || 'votre-domaine.fr'}" %>
  </div>
  <div class="modal-footer">
    <%= link_to "Annuler", employees_path, class: "btn btn-outline-secondary", data: { bs_dismiss: "modal" } %>
    <%= f.button :submit, employee.new_record? ? "Ajouter le collaborateur" : "Enregistrer", class: "btn-primary" %>
  </div>
<% end %>
