
<div class="login-page">
  <div class="login-card">

    <div class="login-header">
      <p class="login-brand">FIL ROUGE</p>
      <h1>Bienvenue</h1>
      <p class="login-subtitle">Connectez-vous à votre espace</p>
    </div>

    <%= form_with model: resource, as: resource_name,
                  url: session_path(resource_name), local: true do |f| %>

      <div class="login-field">
        <%= f.label :email, "Adresse e-mail" %>
        <%= f.email_field :email, autofocus: true,
                          autocomplete: "email",
                          placeholder: "vous@exemple.com" %>
      </div>

      <div class="login-field">
        <%= f.label :password, "Mot de passe" %>
        <%= f.password_field :password,
                             autocomplete: "current-password",
                             placeholder: "Votre mot de passe" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="login-remember">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, "Se souvenir de moi" %>
        </div>
      <% end %>

      <%= f.submit "Se connecter", class: "login-button" %>

    <% end %>

    <div class="login-links">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>

