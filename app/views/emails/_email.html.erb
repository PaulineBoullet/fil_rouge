<article class="email-item">
  <header class="email-item__head">
    <h3 class="email-item__subject"><%= email.subject.presence || "(sans objet)" %></h3>
    <% if email.sent_at %>
      <time class="email-item__date" datetime="<%= email.sent_at.iso8601 %>">
        <%= email.sent_at.strftime("%d/%m/%Y · %H h %M") %>
      </time>
    <% end %>
  </header>

  <p class="email-item__meta">Collaborateur : <%= email.employee.full_name %></p>

  <% if email.summary.present? %>
    <p class="email-item__summary"><strong>Résumé :</strong> <%= email.summary %></p>
  <% end %>

  <% if email.content.present? %>
    <details class="email-item__content">
      <summary>Afficher le mail</summary>
      <%= simple_format(email.content) %>
    </details>
  <% end %>
</article>
