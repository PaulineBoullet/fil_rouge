<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "Fil rouge" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Fil Rouge">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "devise", "data-turbo-track": "reload" if devise_controller? %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= devise_controller? ? "auth-page" : "app-page" %>">
  <% if devise_controller? %>
    <div class="app-shell">
      <main class="app-main">
        <%= render "shared/decor" %>
        <div class="app-content">
          <%= yield %>
        </div>
      </main>
    </div>
  <% else %>
    <%# Cadre en L : barre du haut et rail d'icônes, puis bande grise et panneau blanc %>
    <div class="frame powder">
      <%= render "shared/topbar" %>
      <div class="frame__body">
        <%= render "shared/rail" %>
        <div class="frame__band powder-soft">
          <div class="frame__panel">
            <main class="frame__main" id="contenu">
              <%= yield %>
            </main>
          </div>
        </div>
      </div>
    </div>
  <% end %>

    <%= render "shared/flashes" %>
    <%# Fenêtre modale unique : les formulaires s'y chargent via le cadre Turbo "modal" %>
    <div class="modal fade" id="app-modal" tabindex="-1" aria-hidden="true"
         data-controller="modal"
         data-action="turbo:frame-load->modal#open turbo:frame-missing->modal#close hidden.bs.modal->modal#clear">
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
          <%= turbo_frame_tag "modal" %>
        </div>
      </div>
    </div>

    <%# Fenêtre de confirmation, utilisée par tous les boutons qui portent turbo_confirm %>
    <div class="modal fade" id="confirm-modal" tabindex="-1" aria-hidden="true"
         aria-labelledby="confirm-title" role="alertdialog"
         data-controller="confirm">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <div class="confirm-heading">
              <span class="confirm-icon" aria-hidden="true">
                <i class="fa-solid fa-trash-can"></i>
              </span>
              <h2 id="confirm-title" class="modal-title h5">Confirmer la suppression</h2>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
          </div>
          <div class="modal-body">
            <p data-confirm-target="message"></p>
            <p class="confirm-note">Cette action est définitive.</p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
            <button type="button" class="btn btn-danger" data-action="confirm#accept">Supprimer</button>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
