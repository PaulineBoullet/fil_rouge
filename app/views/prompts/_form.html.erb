<%= simple_form_for prompt do |f| %>
  <div class="modal-body">
    <%= f.error_notification message: "Merci de corriger les champs signalés." %>
    <%= f.input :name, label: "Nom", placeholder: "Nom du prompt" %>
    <%= f.input :content, label: "Instructions", as: :text, input_html: { rows: 8 },
                placeholder: "Résume les échanges du jour avec ce client…",
                hint: "Le texte des mails est ajouté automatiquement après ces instructions." %>
  </div>
  <div class="modal-footer">
    <%= link_to "Annuler", prompts_path, class: "btn btn-outline-secondary", data: { bs_dismiss: "modal" } %>
    <%= f.button :submit, prompt.new_record? ? "Ajouter le prompt" : "Enregistrer", class: "btn-primary" %>
  </div>
<% end %>
