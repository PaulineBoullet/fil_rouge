<% content_for :title, "Dashboard – Fil rouge" %>

<%= breadcrumb %>
<%= render "shared/filters", selected_companies: Company.where(id: selected_domain_ids).order(:name).to_a %>

<% diagnosis = DisplayDiagnosis.new %>
<%= render "pages/diagnosis", diagnosis: diagnosis, empty: @feed.empty? %>

<% unless @feed.empty? %>
  <%= render "pages/feed_page", feed: @feed, cards: @cards %>
<% end %>
