<%# locals: (card:) %>
<% path = card.company ? company_view_path(card.company, **filter_params.except(:view)) : root_path(internal: "1") %>
<%= link_to path, class: ["row-link", ("is-stale" if card.stale?)] do %>
  <span class="row-link__status">
    <% if card.top_status %>
      <span class="sticker__dot sticker--<%= [card.top_status.rank, 4].min %>" aria-hidden="true"></span><%= card.top_status.name %>
    <% end %>
  </span>
  <span class="row-link__name"><%= card.name %></span>
  <span class="row-link__text">
    <%= card.summary&.summary || card.conversations.map(&:display_title).join(" · ") %>
    <% if card.stale? %><em> · <%= later_label(card.later_day) %></em><% end %>
  </span>
  <span class="row-link__count"><%= pluralize_fr(card.conversations.size, "fil") %></span>
<% end %>
