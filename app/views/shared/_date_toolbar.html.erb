<div class="page-toolbar">
  <%= form_with url: request.path, method: :get, class: "date-filter" do |f| %>
    <%= link_to "←", url_for(date: @date - 1), class: "btn btn-outline-secondary", aria: { label: "Jour précédent" } %>
    <%= f.label :date, "Date", class: "visually-hidden" %>
    <%= f.date_field :date, value: @date, class: "form-control" %>
    <%= f.submit "Afficher", class: "btn btn-outline-secondary", name: nil %>
    <%= link_to "→", url_for(date: @date + 1), class: "btn btn-outline-secondary", aria: { label: "Jour suivant" } %>
    <%= link_to "Aujourd'hui", url_for(date: @latest_date),
                class: "btn btn-primary",
                title: "Dernière date avec une synthèse : #{@latest_date.strftime("%d/%m/%Y")}" %>
  <% end %>
</div>
