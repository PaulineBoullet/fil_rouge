<%# locals: (date:, count:) %>
<div class="day-sep">
  <% detail = day_detail(date) %>
  <h2 class="day-sep__title"><%= day_label(date) %><% if detail %> <span class="day-sep__date">· <%= detail %></span><% end %></h2>
  <span class="day-sep__line" aria-hidden="true"></span>
  <span class="day-sep__count"><%= count %></span>
</div>
