<%# locals: (title:, summary:) %>
<section class="summary-panel">
  <header class="summary-panel__header">
    <h2 class="summary-panel__title"><%= title %></h2>
    <% if summary&.generated_at %>
      <span class="summary-panel__date">
        Générée le <%= l(summary.generated_at, format: "%d %B %Y à %H h %M") %>
      </span>
    <% end %>
  </header>

  <% if summary&.summary.present? %>
    <%= simple_format(summary.summary, class: "summary-panel__text") %>
  <% else %>
    <p class="summary-panel__empty">Aucune synthèse pour le <%= l(@date, format: :long) %>.</p>
  <% end %>
</section>
