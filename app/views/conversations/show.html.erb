<% content_for :title, "#{@conversation.display_title} – Fil rouge" %>

<% crumbs = @conversation.company ? [[@conversation.company.name, company_view_path(@conversation.company)]] : [["Fils internes", root_path(internal: "1")]] %>
<%= breadcrumb(*crumbs, title: @conversation.display_title) %>

<section class="synth" aria-label="Synthèse du fil">
  <div class="synth__head">
    <span class="synth__label">
      Synthèse
      <span class="muted">
        <% if @conversation.summary_generated_at %>
          · rédigée le <%= l(@conversation.summary_generated_at, format: "%-d %B à %H h %M") %>
        <% else %>
          · pas encore rédigée
        <% end %>
      </span>
    </span>

    <div class="synth__actions">
      <%= form_with model: @conversation, class: "inline-form", data: { controller: "autosubmit" } do |f| %>
        <%= f.collection_select :status_id, Status.ordered, :id, :name, { include_blank: "Sans statut" },
                                class: "pill-select", aria: { label: "Statut du fil" }, data: { action: "change->autosubmit#submit" } %>
      <% end %>
      <%= form_with model: @conversation, class: "inline-form", data: { controller: "autosubmit" } do |f| %>
        <%= f.collection_select :category_id, Category.ordered, :id, :name, { include_blank: "Sans catégorie" },
                                class: "pill-select", aria: { label: "Catégorie du fil" }, data: { action: "change->autosubmit#submit" } %>
      <% end %>
      <%= button_to toggle_hidden_conversation_path(@conversation), method: :patch, class: "pill-button", form_class: "inline-form" do %>
        <%= icon(:eye_off, size: 16) %> <%= @conversation.hidden? ? "Ne plus masquer" : "Masquer" %>
      <% end %>
    </div>
  </div>

  <% if @conversation.summary.present? %>
    <p class="synth__text"><%= @conversation.summary %></p>
  <% else %>
    <p class="synth__text muted">La synthèse du fil sera rédigée par l'IA après le traitement de nuit.</p>
  <% end %>

  <div class="synth__foot">
    <% if @emails_after_summary.positive? %>
      <span class="muted-small"><%= pluralize_fr(@emails_after_summary, "mail arrivé", "mails arrivés") %> depuis, pas encore pris en compte.</span>
    <% end %>
    <%= button_to "Mettre à jour avec l'IA", analyze_conversation_path(@conversation), class: "btn btn-link btn-sm", form_class: "inline-form" %>
  </div>
</section>

<div class="thread-toolbar">
  <span class="muted-small"><%= pluralize_fr(@total_emails, "message") %></span>
  <details class="thread-search" <%= "open" if @query.present? %>>
    <summary class="pill-button"><%= icon(:search, size: 16) %> Rechercher</summary>
    <%= form_with url: conversation_path(@conversation), method: :get, class: "thread-search__form", role: "search" do %>
      <%= search_field_tag :q, @query, placeholder: "Mot, nom, montant…", class: "pill-input pill-input--wide",
                           aria: { label: "Rechercher dans les messages du fil" }, autofocus: @query.present? %>
      <%= submit_tag "Rechercher", name: nil, class: "btn btn-primary btn-sm" %>
    <% end %>
  </details>
</div>

<% if @query.present? %>
  <p class="thread-search__result">
    <%= pluralize_fr(@days.sum { |_, emails| emails.size }, "message correspond", "messages correspondent") %> à « <%= @query %> ».
    <%= link_to "Afficher tout le fil", conversation_path(@conversation) %>
  </p>
<% end %>

<% if @days.empty? && @query.blank? %>
  <div class="empty-state"><p>Aucun message dans ce fil.</p></div>
<% end %>

<div class="chat">
  <% @days.each do |date, emails| %>
    <section class="chat__day" aria-label="<%= day_label(date) %>">
      <div class="chat__date"><span><%= day_label(date) %><%= " · #{day_detail(date)}" if day_detail(date) %></span></div>
      <%= render partial: "conversations/message", collection: emails, as: :email %>
    </section>
  <% end %>
</div>

<% if @days.any? && @query.blank? %>
  <p class="feed-end">Début du fil<%= " : #{l(@conversation.first_email_at.to_date, format: :long)}" if @conversation.first_email_at %>.</p>
<% end %>

<%# Panneau de lecture d'un mail %>
<%= turbo_frame_tag "mail_panel", src: (email_path(@open_email) if @open_email) %>
