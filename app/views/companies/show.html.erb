<% content_for :title, "#{@company.name} – Fil rouge" %>

<%= breadcrumb title: @company.name %>
<%= render "shared/filters", selected_companies: [@company], show_view_switch: false %>

<% if @company.pending? %>
  <div class="notice-panel">
    Ce domaine tiers n'est pas encore validé : ses fils ne s'afficheront qu'après validation dans
    <%= link_to "Paramètres › Domaines tiers", companies_path %>.
  </div>
<% end %>

<% if @feed.empty? %>
  <div class="empty-state"><p>Aucun fil à afficher pour <%= @company.name %>.</p></div>
<% else %>
  <%= render "companies/feed_page", feed: @feed, cards: @cards, company: @company %>
<% end %>
