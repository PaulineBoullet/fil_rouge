<%= simple_form_for company do |f| %>
  <div class="modal-body">
    <%= f.error_notification message: "Merci de corriger les champs signalés." %>
    <%= f.input :name, label: "Nom", placeholder: "Nom de l'entreprise" %>
    <%= f.input :domain, label: "Domaine de messagerie", placeholder: "exemple.fr",
                hint: "Sans « @ » ni « www ». Les mails venant de ce domaine seront rattachés à l'entreprise." %>
    <%= f.association :prompt, label: "Prompt de synthèse",
                      collection: Prompt.order(:name), include_blank: "Aucun prompt" %>
  </div>
  <div class="modal-footer">
    <%= link_to "Annuler", companies_path, class: "btn btn-outline-secondary", data: { bs_dismiss: "modal" } %>
    <%= f.button :submit, company.new_record? ? "Ajouter l'entreprise" : "Enregistrer", class: "btn-primary" %>
  </div>
<% end %>
